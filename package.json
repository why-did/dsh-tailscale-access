{
  "name": "dsh-tailscale-access",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: one switch that puts the Web GUI on your phone — Tailscale identity or a cloudflared quick tunnel — behind a loopback-rewriting front door that leaves the harness bound to 127.0.0.1.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client/client.js",
    "./proxy": "./lib/proxy.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.5-rc.2"
  },
  "scripts": {
    "test": "node --test tests/"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "remote-access",
    "tailscale",
    "cloudflared",
    "mobile"
  ],
  "license": "MIT",
  "author": "Why Did <whydid.app@gmail.com>",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/why-did/dsh-tailscale-access.git"
  },
  "homepage": "https://github.com/why-did/dsh-tailscale-access#readme",
  "bugs": {
    "url": "https://github.com/why-did/dsh-tailscale-access/issues"
  }
}
